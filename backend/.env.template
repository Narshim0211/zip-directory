# ================================
# SalonHub Backend Configuration
# ================================

# Database Configuration
# -----------------------
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/salonhub

# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/salonhub?retryWrites=true&w=majority

# Authentication
# --------------
JWT_SECRET=change_this_to_a_random_secret_in_production

# News API
# --------
# Get your free API key at: https://newsapi.org/register
# Free tier: 100 requests/day (enough for 8 requests/day with 3-hour cron)
NEWS_API_KEY=your_newsapi_key_here

# CORS Origins
# ------------
# Adjust these URLs based on your deployment
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Server Configuration
# --------------------
PORT=5000
NODE_ENV=development

# Optional: News Configuration
# ----------------------------
# NEWS_REFRESH_INTERVAL_HOURS=3  # Default: 3 hours
# NEWS_CACHE_LIMIT=250           # Default: 250 articles

# =================================
# Reminder System Configuration
# =================================

# SendGrid Email Configuration
# ----------------------------
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Required for email reminders to work
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDER_EMAIL=noreply@yourdomain.com

# Twilio SMS Configuration
# ------------------------
# Get credentials from: https://console.twilio.com/
# Required for SMS reminders to work
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Frontend URL (for email links)
# -----------------------------
FRONTEND_URL=http://localhost:3000
