.vercel

# ====================================
# Environment Files (SENSITIVE DATA)
# ====================================
# Exclude ALL .env files containing sensitive data:
# - Database credentials (MongoDB)
# - API keys (Stripe, AI services)
# - JWT secrets
# - Service authentication tokens

# Root level
.env
.env.local
.env.*.local

# Backend service
backend/.env
backend/.env.local
backend/.env.*

# Time management service
time-service/.env
time-service/.env.local
time-service/.env.*

# Frontend service
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.env.*
frontend.env

# Admin service
admin/.env
admin/.env.local
admin/.env.development
admin/.env.production
admin/.env.*

# Microservices
services/**/.env
services/**/.env.local
services/**/.env.*
services/ai-style-service/.env
services/auth-service/.env
services/booking-service/.env
services/payment-service/.env
services/profile-service/.env

# Any other nested .env files
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production

# BUT keep .env.example and .env.template files (templates are safe)
!**/.env.example
!**/.env.template
!.env.example
!.env.template

# ====================================
# Windows Ghost Files
# ====================================
# Exclude "nul" files (Windows null device file artifacts)
nul
**/nul

# ====================================
# Additional Sensitive Files
# ====================================
# Credentials and secrets
credentials.json
**/credentials.json
secrets.json
**/secrets.json
config.json
**/config.json

# SSL/TLS certificates and keys
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.pub
*.ppk

# Database dumps
*.sql
*.dump
*.backup

# Logs with potential sensitive data
*.log
logs/
**/*.log

# IDE and Editor files (may contain sensitive workspace settings)
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Dependency directories
node_modules/
**/node_modules/

# Build outputs
dist/
build/
*.min.js
*.min.css

# Temporary files
tmp/
temp/
*.tmp

# Test coverage
coverage/
.nyc_output/

# Cache directories
.cache/
.parcel-cache/
.next/

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local development files
.env.development.local
.env.test.local
.env.production.local
